{
  "manifest_version": 3,
  "name": "Sentinel Local Prompt Firewall",
  "version": "0.3.1",
  "description": "Pauses sensitive clipboard pastes before insertion and analyzes them locally in your browser.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/sentinel-engine.js",
        "site-policy.js",
        "paste-controller.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Sentinel site protection",
    "default_popup": "popup.html"
  }
}
